#    [pos_h] = 1008, 428

module DayPhase:
  meta:
    delay = 10

  vars:
    announcement = ""
    @VOTE = ""
    eliminated_today = ""
    announce_text = ""
    @pk_speaker = ""

  action announce @func(werewolf_utils.announce_death):
    in:
      dead_tonight = dead_tonight
    out:
      announcement

  action god_announce @ai(@上帝):
    prompt: |
      天亮了。{announcement}。这是第{day}天白天，存活玩家：{alive}。
      你是上帝，你需要将昨晚的结算结果告诉所有玩家。不可以在发言中暴露夜间具体行动，不可以暴露玩家身份。
    scope: all

  action speak @mind(@speaker):
    prompt: |
      轮到你发言。你是{@speaker}，你的身份是{@speaker.roles}。目前场上存活玩家：{alive}。昨晚 {announcement}。请分享你的想法和怀疑对象。
    scope: all

  action init @assign:
    out:
      $vote_results = {}
      @VOTE = ""

  action vote @mind(@voter):
    prompt: |
      现在是白天，投票时间。你是{@voter}，你的身份是{@voter.roles}。请先分析一下，然后决定投谁。
      最后输出：SET VARIABLE: <<@VOTE = @目标名字>>
    scope: [@上帝, @voter]
    out:
      @VOTE(required)

  action collect_vote @func(werewolf_utils.collect_vote):
    in:
      votes = $vote_results
      voter_name = @voter
      target = @VOTE
    out:
      $vote_results

  action process_vote @func(werewolf_utils.process_votes_and_end):
    in:
      votes = $vote_results
      alive_players = alive
      wolves = wolves
      roles_dict = roles
      sheriff = @sherif
      god = @上帝
    out:
      eliminated_today, alive, wolves, wolf_room, game_over, winner, is_pk, $pk_candidates, vote_route

  action announce_vote @ai(@上帝):
    prompt: |
      投票结束。系统计票记录：{vote_results}。{eliminated_today} 被放逐（「无人」代表全员弃票，或平票——平票时接下来进入平票 PK 环节；警长票按1.5票计）。存活玩家：{alive}。
      你是上帝，请告诉大家投票结果，谁都投了谁。本环节只宣布投票结果，不许说下一步的行动。不可以在发言中透露玩家身份。
    scope: all

  action pk_announce @func(werewolf_utils.pk_announce):
    in:
      pk_candidates = $pk_candidates
      alive_players = alive
      sheriff = @sherif
      day = day
    out:
      announce_text, $pk_voters

  action pk_announce_all @notice:
    prompt: |
      "{announce_text}"
    scope: all

  action pk_speak @mind(@pk_speaker):
    prompt: |
      【平票 PK】你是{@pk_speaker}，你在放逐投票中与其他玩家平票，现在轮到你为自己申辩。
      平票的玩家：{$pk_candidates}。当前存活玩家：{alive}。
      请精炼地为自己申辩：为什么你不该被放逐，或者指出与你平票的玩家哪里更可疑。
      不要暴露自己的身份，也不要在此输出任何 SET VARIABLE 赋值——本环节没有要你填的变量。
    scope: all

  action pk_vote @mind(@voter):
    prompt: |
      【平票 PK 投票】你是{@voter}。刚才的放逐投票出现了平票，现在进行 PK 重投。
      平票的玩家：{$pk_candidates}。你只能从他们之中选择一人投出，得票多者将被放逐。
      请先简要说明你的判断，最后输出：SET VARIABLE: <<@VOTE = @平票玩家之一>>
      只能填写平票玩家名单中的真实名字。
    scope: [@上帝, @voter]
    out:
      @VOTE(required)

  action pk_init @assign:
    out:
      @VOTE = ""
      $vote_results = {}

  action pk_process @func(werewolf_utils.pk_decide_votes):
    in:
      votes = $vote_results
      pk_candidates = $pk_candidates
      alive_players = alive
      roles_dict = roles
      wolves = wolves
      sheriff = @sherif
      day = day
      god = @上帝
    out:
      eliminated_today, alive, wolves, wolf_room, game_over, winner, vote_route, announce_text

  action pk_result_all @notice:
    prompt: |
      "{announce_text}"
    scope: all

  action 移交警徽 @mind(@sherif):
    prompt: |
      你是警长{@sherif}，但你已不在存活玩家名单中。请指定警徽去向：
      若移交给一位存活玩家，请输出：SET VARIABLE: <<@sherif = @你要移交的人>>（只能写存活玩家名单中的名字：{alive}）
      若撕毁警徽，请输出：SET VARIABLE: <<@sherif = "">>
    showprompt: |
      请警长选择移交警徽
    scope: [@上帝, @sherif]
    out:
      @sherif(required)

  action 决定发言顺序 @ai(@sherif):
    prompt: |
      你是警长{@sherif}。请决定今天白天的发言从你的哪一边开始。只输出一行赋值，二选一：
      从左边开始：SET VARIABLE: <<speak_from = 左>>
      从右边开始：SET VARIABLE: <<speak_from = 右>>
    scope: [@上帝, @sherif]
    out:
      speak_from(required)

  action get_order @func(werewolf_utils.get_order):
    in:
      from_ = speak_from
      sheriff = @sherif
      alive = alive
    out:
      order

  flow:
    [announce]: announce
    [speak]: speak
    [vote]: vote
    [announce_vote]: announce_vote
    [god]: god_announce
    [init]: init
    [process_vote]: process_vote
    [c]: collect_vote
    [移交警徽]: 移交警徽
    [移交警徽_2]: 移交警徽
    [决定发言顺序]: 决定发言顺序
    [get_order]: get_order
    [pk_announce]: pk_announce
    [pk_all]: pk_announce_all
    [pk_speak]: pk_speak
    [pk_init]: pk_init
    [pk_vote]: pk_vote
    [pk_collect]: collect_vote
    [pk_process]: pk_process
    [pk_result]: pk_result_all

    [IN] -> [announce]
    [announce] -> [god]
    [god] -> fork:
      -> if ((@sherif != "") and (@sherif in alive == true)) -> [决定发言顺序]
      -> if ((@sherif != "") and (@sherif in alive == false)) -> [移交警徽]
      -> if (@sherif == "") -> [get_order]
    [决定发言顺序] -> [get_order]
    [get_order] -> for @speaker in order:
      -> [speak] ->
    -> [init]
    [init] -> par @voter in alive:
      -> [vote] -> [c] ->
    -> [process_vote]
    [process_vote] -> [announce_vote]
    [announce_vote] -> fork:
      -> if (vote_route == "pk") -> [pk_announce]
      -> if ((vote_route != "pk") and (@sherif != "") and (@sherif in alive == false)) -> [移交警徽_2]
      -> if ((vote_route != "pk") and ((@sherif == "") or (@sherif in alive == true))) -> [OUT]
    [pk_announce] -> [pk_all]
    [pk_all] -> for @pk_speaker in $pk_candidates:
      -> [pk_speak] ->
    -> [pk_init]
    [pk_init] -> par @voter in $pk_voters:
      -> [pk_vote] -> [pk_collect] ->
    -> [pk_process]
    [pk_process] -> [pk_result]
    [pk_result] -> fork:
      -> if ((@sherif != "") and (@sherif in alive == false)) -> [移交警徽_2]
      -> if ((@sherif == "") or (@sherif in alive == true)) -> [OUT]
    [移交警徽_2] -> [OUT]
    [移交警徽] -> [get_order]

#  sketch:
#    [FOR] = 138, 167
#    [PAR] = 263, 86
#    [PAR_出] = 272, 336
#    [OUT] = 457, 14
#    [announce] = -159, -10
