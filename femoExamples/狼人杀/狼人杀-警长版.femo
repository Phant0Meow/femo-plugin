module Election:
  meta:
    delay = 10

  vars:
    @start = ""
    want_badge = false
    @vote_target = ""
    announce_text = ""
    @pk_speaker = ""

  action init @assign:
    out:
      $sheriff_candidates = []
      $vote_results = {}

  action 是否上警 @mind(@player):
    prompt: |
      警长竞选开始，你是{@player}，你的身份是{@player.roles}。是否上警竞选警长？
      若要上警，请输出：SET VARIABLE: <<want_badge = true>>
      若不上警，请直接简短说明你放弃上警，不要输出任何赋值。
    scope: [@上帝, @player]
    out:
      want_badge

  action collect_candidacy @func(werewolf_utils.collect_candidacy):
    in:
      candidates = $sheriff_candidates
      player_name = @player
      want = want_badge
    out:
      $sheriff_candidates

  action 上帝指定起始 @ai(@上帝):
    prompt: |
      上警玩家有：{$sheriff_candidates}。
      如果有上警玩家，请随机选择其中一人作为第一个发言者，
      输出：SET VARIABLE: <<@start = @玩家名>>。
      如果没有人上警，则不要输出赋值。
      随便选，越没道理越好。
    scope: all
    out:
      @start

  action 生成发言顺序 @func(werewolf_utils.get_speaker_order_from_start):
    in:
      candidates = $sheriff_candidates
      start = @start
    out:
      speaker_order

  action 警上发言 @mind(@player):
    prompt: |
      你是{@player}，请发表你的警长竞选发言，说明你的优势，并给出你对场上的初步判断。
    scope: all

  action 生成投票者列表 @func(werewolf_utils.get_sheriff_voter_order):
    in:
      alive = alive
      candidates = $sheriff_candidates
    out:
      voter_order

  action 投票 @mind(@voter):
    prompt: |
      你是{@voter}，现在是警长竞选投票。
      你是警下玩家，只能从警上玩家中选择一人投票。
      警上玩家：{$sheriff_candidates}。
      最后必须输出：
      SET VARIABLE: <<@vote_target = @你支持的警上玩家>>
      只能填写警上玩家名单中的真实名字。
    scope: [@上帝, @voter]
    out:
      @vote_target(required)

  action 收集投票 @func(werewolf_utils.collect_vote):
    in:
      votes = $vote_results
      voter_name = @voter
      target = @vote_target
    out:
      $vote_results

  action 处理选举 @func(werewolf_utils.process_election_votes):
    in:
      votes = $vote_results
      candidates = $sheriff_candidates
      alive = alive
    out:
      @sherif, is_pk, $pk_candidates, election_route

  action 竞选pk播报 @func(werewolf_utils.pk_announce_election):
    in:
      pk_candidates = $pk_candidates
      candidates = $sheriff_candidates
      alive_players = alive
    out:
      announce_text, $pk_voters

  action 竞选pk公告 @notice:
    prompt: |
      "{announce_text}"
    scope: all

  action 竞选pk申辩 @mind(@pk_speaker):
    prompt: |
      【警长竞选 · 平票 PK】你是{@pk_speaker}，你在警长竞选中与其他候选人平票，现在轮到你为自己拉票。
      平票的候选人：{$pk_candidates}。当前存活玩家：{alive}。
      请精炼地补充你的竞选理由，说明为什么你更适合当警长。
      不要暴露自己的身份，也不要在此输出任何 SET VARIABLE 赋值——本环节没有要你填的变量。
    scope: all

  action 竞选pk投票 @mind(@voter):
    prompt: |
      【警长竞选 · 平票 PK 投票】你是{@voter}，刚才的警长竞选投票出现平票，现在进行 PK 重投。
      平票的候选人：{$pk_candidates}。你只能从他们之中选择一人投票，得票多者当选警长。
      最后必须输出：SET VARIABLE: <<@vote_target = @平票候选人之一>>
      只能填写平票候选人名单中的真实名字。
    scope: [@上帝, @voter]
    out:
      @vote_target(required)

  action 竞选pk重置 @assign:
    out:
      @vote_target = ""
      $vote_results = {}

  action 竞选pk结算 @func(werewolf_utils.pk_decide_election):
    in:
      votes = $vote_results
      pk_candidates = $pk_candidates
      candidates = $sheriff_candidates
      alive = alive
    out:
      @sherif, election_route, announce_text

  action 竞选pk结果公告 @notice:
    prompt: |
      "{announce_text}"
    scope: all

  action 宣布警长 @ai(@上帝):
    prompt: |
      计票结果：{$vote_results}。
      警长竞选结束。当前警长：{@sherif}。
      如果 {@sherif} 为空，则宣布无人当选警长（平票 PK 后仍无人胜出，或无人上警）。
      请向全体玩家宣布警长归属，并说明警长的特权：白天放逐投票计1.5票，每天决定从警长的哪一边开始发言。
    scope: all

  flow:
    [init]: init
    [是否上警]: 是否上警
    [collect_candidacy]: collect_candidacy
    [上帝指定起始]: 上帝指定起始
    [生成发言顺序]: 生成发言顺序
    [警上发言]: 警上发言
    [生成投票者列表]: 生成投票者列表
    [投票]: 投票
    [收集投票]: 收集投票
    [处理选举]: 处理选举
    [宣布警长]: 宣布警长
    [竞选pk播报]: 竞选pk播报
    [竞选pk公告]: 竞选pk公告
    [竞选pk申辩]: 竞选pk申辩
    [竞选pk重置]: 竞选pk重置
    [竞选pk投票]: 竞选pk投票
    [竞选pk收票]: 收集投票
    [竞选pk结算]: 竞选pk结算
    [竞选pk结果]: 竞选pk结果公告

    [IN] -> [init]
    [init] -> par @player in alive:
      -> [是否上警] -> [collect_candidacy] ->
    -> [上帝指定起始]
    [上帝指定起始] -> [生成发言顺序]
    [生成发言顺序] -> for @player in speaker_order:
      -> [警上发言] ->
    -> [生成投票者列表]
    [生成投票者列表] -> par @voter in voter_order:
      -> [投票] -> [收集投票] ->
    -> [处理选举]
    [处理选举] -> fork:
      -> if (election_route == "pk") -> [竞选pk播报]
      -> if (election_route != "pk") -> [宣布警长]
    [竞选pk播报] -> [竞选pk公告]
    [竞选pk公告] -> for @pk_speaker in $pk_candidates:
      -> [竞选pk申辩] ->
    -> [竞选pk重置]
    [竞选pk重置] -> par @voter in $pk_voters:
      -> [竞选pk投票] -> [竞选pk收票] ->
    -> [竞选pk结算]
    [竞选pk结算] -> [竞选pk结果]
    [竞选pk结果] -> [宣布警长]
    [宣布警长] -> [OUT]

