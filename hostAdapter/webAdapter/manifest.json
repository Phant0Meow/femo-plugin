    },
    {
      "matches": ["https://www.qianwen.com/*"],
      "js": ["sites/www.qianwen.com/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.qianwen.com/*"],
