meta:
  name = 狼人杀警长版
  version = 2.1
  owner = 001
  session = new
  output_style = |
    这是新的一局狼人杀游戏！从这里开始后面都是新的，不要被过去的记录误导。
       你的身份牌决定了你所在的阵营，你要动脑子，努力让自己的阵营获胜。你要努力赢！
    这是6人局：2狼，2神（预言家、女巫），2村民。其中村民和神是好人阵营，狼人是狼人阵营。
    第一天白天有警长竞选：上警的玩家竞选警长，警下玩家投票选出警长。警长白天放逐投票计1.5票，并决定每天从他的哪一边开始发言。
    投票平票不空过：平票的玩家进入平票 PK，每人简短申辩后由其余玩家在他们之中重投一次，得票多者被放逐（警长竞选平票则得票多者当选）；若 PK 重投再次平票，放逐投票今日无人出局、警长竞选无人当选。
    发言要有逻辑分析，不能瞎猜。第一天夜晚没有信息，不要幻觉。推理要依赖真实的聊天记录。
    当你们想要指定玩家成为行动对象时，必须@他，且只能使用场上存活玩家名单中真实存在的玩家名。
    名单里没有的名字绝不能用——例如名单里有 @1号，输出变量时就写 @1号；名单里没有 Kate，就绝不能写 @Kate。
    发言精炼有逻辑，不要长篇大论；夜晚行动回合的回复要简短。
    你没有调用任何工具的能力，严禁使用工具，直接根据你看到的聊天记录发言。

actors:
  ai @1号 = soul:ai1
  ai @2号 = soul:ai2
  ai @3号 = soul:ai3
  ai @4号 = soul:ai4
  ai @5号 = soul:ai5
  human @6号 = soul:human, source:0
  ai @god = soul:ai6

code:
  werewolf_utils = file:"D:\myFiles\dsh\femo-plugin\femoExamples\狼人杀\werewolf_utils2.py"

vars:
  roles = {}
  $alive = [@1号, @2号, @3号, @4号, @5号, @6号]
  $wolves = []
  $wolf_room = []
  $witch_has_antidote = true
  $witch_has_poison = true
  $dead_tonight = []
  $game_over = false
  $winner = ""
  $sheriff_candidates = []
  $vote_results = {}
  @speaker = ""
  @voter = ""
  @player = ""
  @狼人 = ""
  day = 0
  @上帝 = @god
  @预言家 = ""
  @女巫 = ""
  @村民1 = ""
  @村民2 = ""
  $@sherif = ""
  speak_from = ""
  order = []
  speaker_order = []
  voter_order = []
  is_pk = false
  $pk_candidates = []
  $pk_voters = []
  vote_route = ""
  election_route = ""

action roleCard @func(werewolf_utils.assign_roles):
  in:
    players = alive
    god = @上帝
  out:
    roles, wolves, wolf_room, @预言家, @女巫, @村民1, @村民2

module NightPhase:
  vars:
    @KILL = ""
    SAVE = false
    @POISON = ""
    @CHECK = ""
    seer_check_result = ""
    witch_prompt_text = ""
    wolf_fail_count = 0

  action nextDay @assign:
    out:
      day += 1

  action wolf_fail @assign:
    out:
      wolf_fail_count += 1

  action wolf_discuss @mind(@狼人):
    prompt: |
      这是第{day}天晚上，夜晚降临。目前场上存活玩家：{alive}。
      wolves成员： {wolves}。你是{@狼人}, 你的身份卡是狼人。请选择你的击杀对象。
      当你决定击杀对象时，需要输出：SET VARIABLE:<<@KILL = @目标名字>>
    scope: wolf_room
    out:
      @KILL(required)

  action seer_check @mind(@预言家):
    prompt: |
      你是{@预言家}，你的身份是预言家，请选择你今晚要查验的玩家。目前场上的存活玩家：{alive}
      你需要通过变量赋值语句：SET VARIABLE:<<@CHECK = @目标名字>> 告诉上帝你的查验对象。
    scope: [@上帝, @预言家]
    out:
      @CHECK(required)

  action seer_result @func(werewolf_utils.check_role):
    in:
      target_name = @CHECK
      roles_dict = roles
    out:
      seer_check_result

  action tell_seer @mind(@预言家):
    prompt: |
      现在是夜晚，你查验了 {@CHECK}，结果是：{seer_check_result}。
    scope: [@上帝, @预言家]

  action witch_prompt @func(werewolf_utils.build_witch_prompt):
    in:
      has_antidote = witch_has_antidote
      has_poison = witch_has_poison
      kill_target = @KILL
      alive_players = alive
      witch_name = @女巫
    out:
      witch_prompt_text

  action witchTurn @mind(@女巫):
    prompt: |
      {witch_prompt_text}
    scope: [@上帝, @女巫]
    out:
      SAVE, @POISON

  action resolve_night @func(werewolf_utils.resolve_night):
    in:
      kill_target = @KILL
      save = SAVE
      poison_target = @POISON
      alive_players = alive
      has_antidote = witch_has_antidote
      has_poison = witch_has_poison
      wolves = wolves
      god = @上帝
    out:
      dead_tonight, alive, wolves, wolf_room, witch_has_antidote, witch_has_poison

  flow:
    [seer_check]: seer_check
    [seer_result]: seer_result
    [tell_seer]: tell_seer
    [witchTurn]: witchTurn
    [witch_prompt]: witch_prompt
    [resolve_night]: resolve_night
    [nextDay]: nextDay
    [wolf_discuss]: wolf_discuss
    [pos_4]: 
    [pos_3]: 
    [FAIL]: wolf_fail
    [pos_1]: 
    [pos_2]: 
    [pos_h]: 

    [IN] -> [nextDay]
    [nextDay] -> [pos_4]
    [pos_4] -> for @狼人 in wolves:
      -> if (@狼人 in alive == true) -> [wolf_discuss] ->
    -> [pos_3]
    [pos_3] -> fork:
      -> if (@KILL == "") -> [FAIL]
      -> if (@KILL != "") -> [pos_1]
    [FAIL] -> fork:
      -> if (wolf_fail_count < 3) -> [pos_4]
      -> if (wolf_fail_count >= 3) -> [pos_1]
    [pos_1] -> fork:
      -> if (@预言家 in alive == false) -> [pos_2]
      -> if (@预言家 in alive == true) -> [seer_check]
    [pos_2] -> fork:
      -> if (@女巫 in alive != true) -> [pos_h]
      -> if (@女巫 in alive == true) -> [witch_prompt]
    [pos_h] -> [resolve_night]
    [resolve_night] -> [OUT]
    [witch_prompt] -> [witchTurn]
    [witchTurn] -> [pos_h]
    [seer_check] -> [seer_result]
    [seer_result] -> [tell_seer]
    [tell_seer] -> [pos_2]

#  sketch:
#    [FOR] = 200, 200
#    [OUT] = 600, 380
#    [seer_check] = 448, 88
#    [seer_result] = 583, 29
#    [tell_seer] = 629, 110
#    [witchTurn] = 1153, 419
