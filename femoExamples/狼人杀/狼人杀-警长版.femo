module chat:
  action chat @mind(@player):
    prompt: |
      游戏结束啦，随便聊聊吧～
    scope: all

  action chat_human @human(@3号):
    scope: all

  flow:
    [chat]: chat
    [hub]: 
    [AI_line]: 
    [chat_human]: chat_human
    [human_line]: 

    [IN] -> [hub]
    [hub] -> fork:
      -> [AI_line]
      -> [human_line]
    [AI_line] -> for @player in [@1号, @2号, @4号, @5号, @6号, @god]:
      -> [chat] ->
    -> [OUT]
    [human_line] -> [chat_human]
    [chat_human] -> [human_line]

#  sketch:
#    [FOR] = -224, 187
#    [OUT] = 3, 185
#    [chat] = -119, 261
#    [hub] = 1, 102
#    [AI_line] = -166, 120
#    [chat_human] = 149, 193
#    [human_line] = 154, 116

mainflow:
  [roleCard]: roleCard
  [game_loop]: &NightPhase
  [day]: &DayPhase
  [chat]: &chat
  [Election]: &Election
  [pos_1]: 

  [START] -> [roleCard]
  [roleCard] -> [game_loop]
  [game_loop] -> [pos_1]
  [pos_1] -> fork:
    -> if (day == 1) -> [Election]
    -> if (day > 1) -> [day]
  [Election] -> [day]
  [day] -> fork:
    -> if (game_over == false) -> [game_loop]
    -> if (game_over == true) -> [chat]
  [chat] -> [END]

