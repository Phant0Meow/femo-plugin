# Plan模式：先讨论出方案（讨论期严禁动文件），人类拍板通过后才允许动手改。
# 与 Goal模式 配套：Goal 防中途停，Plan 防未批先干。
#
# 用法：把 [talk] 里"方案讨论"的 prompt 换成你自己的议题，
#       在 femoGen 里跑起来后，讨论到满意就在拍板节点输入 planPass = true。
#       只想实验的话，[talk] 的 prompt 直接写你要讨论的任务即可。

meta:
  name = Plan模式
  system_safety = 讨论节点内禁止修改任何文件、禁止执行任何写操作，只输出方案文本。

actors:
  ai @AI = source:main       # 主agent本人下场讨论
  human @用户                 # 人类用户（无 source，保留上帝视角）

vars:
  planPass = false           # 用户是否批准方案

action 讨论 @ai(@AI):
  prompt: |
    【当前阶段：方案讨论阶段——只准说，不准做】
    你和用户正在一起讨论一个方案。本轮你只能做这些事：
    1. 陈述你的理解、方案构想、步骤拆解与取舍理由；
    2. 回答用户的疑问、提出你需要用户确认的关键点；
    3. 根据用户的反馈修改方案文本。
    本轮严禁的行为（违反即为失职）：
    - 不得创建、写入、编辑、删除任何文件；
    - 不得调用任何会改动环境的工具（写文件、执行命令、提交、部署等）；
    - 不得声称"我已经改好了""已经创建了 xxx"。
    你手上只有嘴，没有手。所有动作都必须等方案通过后再做。
    不要输出任何变量赋值，讨论阶段由用户说了算。
  showprompt: "———— 方案讨论阶段：只谈方案，不动文件 ————"

action 拍板 @human(@用户):
  prompt: "你批准这个方案吗？批准（会进入动手实施）请输入 planPass = true；还想继续讨论请输入 planPass = false。"
  showprompt: "【等待用户拍板】planPass = true 表示方案通过；false 表示继续讨论。"
  out: planPass

action 实施 @ai(@AI):
  prompt: |
    【方案已通过，可以开始修改文件了！】
    讨论阶段结束，现在进入实施阶段，你获得了动手的权限。
    请遵照上面已通过的方案，开始实际修改文件、执行命令、把方案落地。
    实施中如果发现方案有硬伤，先停下来向用户说明，不要擅自扩大改动范围。
    完成后向用户汇报：改了哪些文件、每个文件改了什么、怎么验证的。
  showprompt: "———— 方案已通过，进入实施阶段 ————"

mainflow:
  [START] -> [talk]:讨论

  [talk] -> [approve]:拍板
  [approve] -> if (planPass == false) -> [talk]    # 未通过：回到讨论，继续磨方案
  [approve] -> if (planPass == true) -> [build]:实施   # 通过：放行动手

  [build] -> [END]
